{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/blog/src",
  "generateOptions": {
    "flat": false,
    "spec": false
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/blog/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/blog",
  "projects": {
    "advance": {
      "type": "library",
      "root": "libs/advance",
      "entryFile": "index",
      "sourceRoot": "libs/advance/src",
      "compilerOptions": {
        "tsConfigPath": "libs/advance/tsconfig.lib.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "blog": {
      "type": "application",
      "root": "apps/blog",
      "entryFile": "main",
      "sourceRoot": "apps/blog/src",
      "compilerOptions": {
        "tsConfigPath": "apps/blog/tsconfig.app.json"
      }
    },
    "books": {
      "type": "application",
      "root": "apps/books",
      "entryFile": "main",
      "sourceRoot": "apps/books/src",
      "compilerOptions": {
        "tsConfigPath": "apps/books/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "email": {
      "type": "library",
      "root": "libs/email",
      "entryFile": "index",
      "sourceRoot": "libs/email/src",
      "compilerOptions": {
        "tsConfigPath": "libs/email/tsconfig.lib.json"
      }
    },
    "oss": {
      "type": "library",
      "root": "libs/oss",
      "entryFile": "index",
      "sourceRoot": "libs/oss/src",
      "compilerOptions": {
        "tsConfigPath": "libs/oss/tsconfig.lib.json"
      }
    },
    "password": {
      "type": "application",
      "root": "apps/password",
      "entryFile": "main",
      "sourceRoot": "apps/password/src",
      "compilerOptions": {
        "tsConfigPath": "apps/password/tsconfig.app.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "talk": {
      "type": "application",
      "root": "apps/talk",
      "entryFile": "main",
      "sourceRoot": "apps/talk/src",
      "compilerOptions": {
        "tsConfigPath": "apps/talk/tsconfig.app.json"
      }
    },
    "typeorm": {
      "type": "library",
      "root": "libs/typeorm",
      "entryFile": "index",
      "sourceRoot": "libs/typeorm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/typeorm/tsconfig.lib.json"
      }
    }
  }
}